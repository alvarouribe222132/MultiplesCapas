<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:GestionITM.AppMovil.ViewModels"
             xmlns:models="clr-namespace:GestionITM.AppMovil.Models"
             x:Class="GestionITM.AppMovil.Views.ProfesoresPage"
             x:DataType="viewmodels:ProfesoresViewModel"
             Title="Profesores ITM">

	<Grid RowDefinitions="Auto, *, Auto" Padding="10">

		<ActivityIndicator Grid.Row="0"
							IsRunning="{Binding EstaCargando}"
							IsVisible="{Binding EstaCargando}"
							Color="Blue" />

		<CollectionView Grid.Row="1" ItemsSource="{Binding ListaProfesores}">
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="models:ProfesorModel">
					<Border Margin="5" Padding="10" Stroke="LightGray" StrokeThickness="1">
						<Border.StrokeShape>
							<RoundRectangle CornerRadius="5" />
						</Border.StrokeShape>
					
					<Grid ColumnDefinitions="*, Auto, Auto, Auto">
							<!-- Info -->
							<VerticalStackLayout Grid.Column="0">
								<VerticalStackLayout.GestureRecognizers>
									<TapGestureRecognizer Tapped="OnVerDetalleClicked"/>
								</VerticalStackLayout.GestureRecognizers>
								<Label Text="{Binding NombreCompleto}"
                                       FontSize="16" FontAttributes="Bold"/>
								<Label Text="{Binding Especialidad}"
                                       FontSize="13" TextColor="Gray"/>
								<Label Text="{Binding Correo}"
                                       FontSize="12" TextColor="DarkBlue"/>
								<Label Text="{Binding Telefono, StringFormat='📞 {0}'}" FontSize="12" TextColor="Green"/>
							</VerticalStackLayout>

							<!-- Botones -->
							<Button Grid.Column="1" Text="👁️"
                                    BackgroundColor="Blue" TextColor="White"
                                    Clicked="OnVerDetalleClicked" Margin="3,0"/>
							<Button Grid.Column="2" Text="✏️"
                                    BackgroundColor="Orange" TextColor="White"
                                    Clicked="OnEditarClicked" Margin="3,0"/>
							<Button Grid.Column="3" Text="🗑️"
                                    BackgroundColor="Red" TextColor="White"
                                    Clicked="OnEliminarClicked"/>
						</Grid>
					</Border>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
		<Button Grid.Row="2" Text="➕ Agregar Profesor"
                Clicked="OnAgregarClicked"
                BackgroundColor="Green" TextColor="White"
                Margin="0,10,0,0"/>

	</Grid>
</ContentPage>