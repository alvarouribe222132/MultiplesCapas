<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    xmlns:views="clr-namespace:GestionITM.AppMovil.Views"
    x:Class="GestionITM.AppMovil.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GestionITM.AppMovil"
    Title="GestionITM.AppMovil">

	<ShellContent
        Title="Inicio"
        ContentTemplate="{DataTemplate views:ProfesoresPage}"
        Route="ProfesoresPage" 
        xmlns:views="clr-namespace:GestionITM.AppMovil.Views"/>

	<ShellContent
        Route="login"
        ContentTemplate="{DataTemplate views:LoginView}" />

	<ShellContent
        Route="catalogo"
        ContentTemplate="{DataTemplate views:CatalogoView}" />

</Shell>