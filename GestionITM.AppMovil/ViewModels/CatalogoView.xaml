<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="GestionITM.AppMovil.Views.CatalogoView">

	<CollectionView
        x:Name="CursosCollection"
        RemainingItemsThreshold="2"
        RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">

		<CollectionView.ItemTemplate>
			<DataTemplate>

				<Frame Margin="10">

					<VerticalStackLayout>

						<Label
                            Text="{Binding NombreCurso}"
                            FontSize="20"
                            FontAttributes="Bold"/>

						<Label
                            Text="{Binding NombreProfesor}"/>

						<Label
                            Text="{Binding Creditos}"/>

						<Button
                            Text="Matricular"
                            Clicked="OnMatricularClicked"/>

					</VerticalStackLayout>

				</Frame>

			</DataTemplate>
		</CollectionView.ItemTemplate>

	</CollectionView>

</ContentPage>