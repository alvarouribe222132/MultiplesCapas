<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GestionITM.AppMovil.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GestionITM.AppMovil.Views"
    FlyoutBehavior="Flyout">
	<Shell.FlyoutHeader>
		<Grid BackgroundColor="#512BD4" HeightRequest="100">
			<Label Text="MENU ITM" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20"/>
		</Grid>
	</Shell.FlyoutHeader>

	<FlyoutItem x:Name="FlyoutProfesores" Title="Profesores" Icon="icon_profesor.png">
		<ShellContent ContentTemplate="{DataTemplate views:ProfesoresPage}" />
	</FlyoutItem>

	<FlyoutItem x:Name="FlyoutEstudiantes" Title="Estudiantes" Icon="icon_estudiante.png">
		<ShellContent ContentTemplate="{DataTemplate views:EstudiantesPage}" />
	</FlyoutItem>

	<FlyoutItem x:Name="FlyoutCursos" Title="Cursos" Icon="icon_curso.png">
		<ShellContent ContentTemplate="{DataTemplate views:CatalogoView}" />
	</FlyoutItem>

	<FlyoutItem x:Name="FlyoutMatriculas" Title="Matrículas" Icon="icon_matricula.png">
		<ShellContent ContentTemplate="{DataTemplate views:MatriculasPage}" />
	</FlyoutItem>

</Shell>