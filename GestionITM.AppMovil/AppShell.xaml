<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GestionITM.AppMovil.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:GestionITM.AppMovil.Views"
    Shell.NavBarIsVisible="False">

	<ShellContent
        Route="login"
        ContentTemplate="{DataTemplate views:LoginView}" />
	<!-- Menú principal -->
	<TabBar Route="main">
		<Tab Title="📚 Cursos" Icon="course.png">
			<ShellContent
                Route="catalogo"
                ContentTemplate="{DataTemplate views:CatalogoView}" />
		</Tab>
		<Tab Title="👨‍🎓 Estudiantes">
			<ShellContent Route="estudiantes"
                ContentTemplate="{DataTemplate views:EstudiantesPage}" />
		</Tab>
		<Tab Title="📋 Matrículas">
			<ShellContent Route="matriculas"
                ContentTemplate="{DataTemplate views:MatriculasPage}" />
		</Tab>
		<Tab Title="👨‍🏫 Profesores" Icon="teacher.png">
			<ShellContent
                Route="profesores"
                ContentTemplate="{DataTemplate views:ProfesoresPage}" />
		</Tab>
	</TabBar>

</Shell>